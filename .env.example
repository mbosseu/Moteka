# Variables du jeu concours FIGHT & Furious (fonctions /api/concours/*).
# Sur Vercel : Settings, Environment Variables (Production). Ne jamais committer de vraies valeurs.

# Meme projet Supabase que le concours Boxing Center
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mails en texte brut via Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=suzinabot@gmail.com
BREVO_SENDER_NAME=David
BREVO_REPLY_TO=boxingcenter31@gmail.com

# Notifications internes (liste separee par des virgules)
CONCOURS_NOTIF_EMAILS=boxingcenter31@gmail.com,contact@moteka.fr

# URL publique de la page (liens dans les mails). Prod : https://fight-and-furious.boxingcenter.fr
PUBLIC_URL=

# ---------- Back-office /admin (fonctions /api/admin/*) ----------
# Memes identifiants que le back-office de la boutique BOXPLUS :
# super administrateur (memes valeurs que dans le projet Vercel de BOXPLUS)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Comptes app_users (hachages bcrypt) de la base Supabase BOXPLUS.
# A renseigner seulement si cette base n'est pas la meme que SUPABASE_URL ci-dessus.
ADMIN_USERS_SUPABASE_URL=
ADMIN_USERS_SUPABASE_SERVICE_ROLE_KEY=
# Secret de signature du cookie de session (32 caracteres aleatoires ou plus, propre a Moteka).
# Exemple de generation : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOTEKA_ADMIN_SESSION_SECRET=
# Secret HMAC des QR de tickets PDF (32+ caracteres). A defaut, MOTEKA_ADMIN_SESSION_SECRET est utilise.
MOTEKA_TICKET_SECRET=
