{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/fight-furious/index.html" },
    { "source": "/:chemin((?!fight-furious/).*)", "destination": "/fight-furious/:chemin" }
  ],
  "headers": [
    {
      "source": "/fight-furious/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
